<% content_for :auto_refresh, true %>
<% content_for :title, "Dashboard" %>

<div class="so-content__header">
  <h1>Dashboard</h1>
</div>

<% if @stats[:available] %>
  <div class="so-stat-cards">
    <%= render "solid_observer/shared/stat_card", label: "Ready", value: @stats[:ready], color: "success" %>
    <%= render "solid_observer/shared/stat_card", label: "Scheduled", value: @stats[:scheduled], color: "warning" %>
    <%= render "solid_observer/shared/stat_card", label: "Claimed", value: @stats[:claimed], color: "info" %>
    <%= render "solid_observer/shared/stat_card", label: "Failed", value: @stats[:failed], color: "danger" %>
    <%= render "solid_observer/shared/stat_card", label: "Workers", value: @stats[:workers], color: "info" %>
  </div>

  <% if @stats[:queues].any? %>
    <div class="so-card" style="margin-bottom: 2rem;">
      <div class="so-card__label">Queue Depths</div>
      <table class="so-table" style="margin-top: 1rem;">
        <thead>
          <tr>
            <th>Queue</th>
            <th>Jobs</th>
          </tr>
        </thead>
        <tbody>
          <% @stats[:queues].each do |queue_name, count| %>
            <tr>
              <td><%= queue_name %></td>
              <td><%= format_number(count) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if persistence_mode? %>
    <% if @recent_failures.any? %>
      <div class="so-card" style="border-left: 4px solid var(--so-danger); margin-bottom: 2rem;">
        <div class="so-card__label" style="color: var(--so-danger);">Recent Failures</div>
        <table class="so-table" style="margin-top: 1rem;">
          <thead>
            <tr>
              <th>Job Class</th>
              <th>Queue</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_failures.each do |event| %>
              <tr>
                <td><%= event.job_class %></td>
                <td><%= event.queue_name %></td>
                <td><%= time_ago_in_words(event.recorded_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>

    <% if @recent_events.any? %>
      <div class="so-card">
        <div class="so-card__label">Recent Events</div>
        <table class="so-table" style="margin-top: 1rem;">
          <thead>
            <tr>
              <th>Event</th>
              <th>Job Class</th>
              <th>Queue</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            <% @recent_events.each do |event| %>
              <tr>
                <td><%= event.event_type.humanize %></td>
                <td><%= event.job_class %></td>
                <td><%= event.queue_name %></td>
                <td><%= time_ago_in_words(event.recorded_at) %> ago</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
<% else %>
  <div class="so-card">
    <div class="so-empty">
      <div class="so-empty__icon">⚠️</div>
      <div>SolidQueue is not available</div>
    </div>
  </div>
<% end %>
